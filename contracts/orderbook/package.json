{
    "name": "@0x/contracts-orderbook",
    "version": "1.0.0",
    "description": "ETH-ERC20 Limit Order Book Smart Contracts",
    "main": "lib/src/index.js",
    "types": "lib/src/index.d.ts",
    "scripts": {
        "build": "yarn build:contracts && yarn build:ts",
        "build:contracts": "hardhat compile --force",
        "build:ts": "tsc -b",
        "generate_contract_wrappers": "typechain --target ethers-v6 --out-dir src/types './artifacts/contracts/**/*.json'",
        "generate_contract_wrappers:force": "yarn build:contracts && yarn generate_contract_wrappers",
        "test": "hardhat test",
        "test:forge": "forge test -vvv",
        "test:coverage": "hardhat coverage",
        "clean": "hardhat clean && rm -rf lib src/types cache artifacts out",
        "lint": "yarn lint:contracts && yarn lint:ts",
        "lint:contracts": "solhint 'contracts/**/*.sol'",
        "lint:ts": "eslint . --ext .ts"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/0xProject/protocol.git"
    },
    "license": "Apache-2.0",
    "bugs": {
        "url": "https://github.com/0xProject/protocol/issues"
    },
    "homepage": "https://github.com/0xProject/protocol/tree/development/contracts/orderbook",
    "devDependencies": {
        "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
        "@nomicfoundation/hardhat-ethers": "^3.0.0",
        "@nomicfoundation/hardhat-foundry": "^1.1.0",
        "@nomicfoundation/hardhat-toolbox": "^5.0.0",
        "@openzeppelin/contracts": "^5.4.0",
        "@typechain/ethers-v6": "^0.5.0",
        "@typechain/hardhat": "^9.0.0",
        "@types/chai": "^4.3.0",
        "@types/mocha": "^10.0.0",
        "@types/node": "^20.0.0",
        "chai": "^4.3.10",
        "ethers": "^6.13.0",
        "forge-std": "^1.1.2",
        "hardhat": "^2.22.0",
        "solhint": "^5.0.0",
        "typechain": "^8.3.0",
        "typescript": "^5.0.0"
    },
    "publishConfig": {
        "access": "public"
    }
}
